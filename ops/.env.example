# Copy to ops/.env and fill in. `ops/gen-secrets.sh` writes one for you.
# Never commit ops/.env.

# Public addresses. A real domain gets automatic HTTPS from Caddy.
SITE_ADDRESS=:80
ADMIN_ADDRESS=:8080
# true once you serve over HTTPS (cookies are then Secure-only).
COOKIE_SECURE=false

POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Encrypts merchants' webhook secrets at rest.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Shared secret between api and settlement's internal API.
SETTLEMENT_INTERNAL_TOKEN=
# Secret the acquirer signs callbacks with.
ACQUIRER_CALLBACK_SIGNING_SECRET=

# There is no email/SMS provider. true = login codes (merchant + admin) are
# written to the API log (`docker compose -f ops/docker-compose.yml logs api`),
# which is the only way to log in on the hosted box. Never in HTTP responses.
OTP_LOG_CODES=false
