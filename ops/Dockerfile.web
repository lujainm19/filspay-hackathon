# Builds the merchant dashboard (apps/web) and the ops console (apps/admin)
# as static files and serves them, plus the API, through Caddy.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --no-audit --no-fund
COPY . .
# Same-origin API: the browser calls /v1/* on the host that served the page.
ENV VITE_API_BASE_URL="" VITE_ADMIN_API_BASE_URL=""
RUN npm run build --workspace apps/web && npm run build --workspace apps/admin

FROM caddy:2-alpine
COPY ops/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/web
COPY --from=build /app/apps/admin/dist /srv/admin
